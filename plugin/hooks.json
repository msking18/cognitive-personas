{
  "cognitive-personas": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node --no-warnings scripts/hydrate-pedagogy.js",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings scripts/friction-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
